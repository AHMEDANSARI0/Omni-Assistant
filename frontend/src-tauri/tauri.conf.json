{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni-Assistant Command Center",
  "version": "0.82.17",
  "identifier": "local.omni.assistant.commandcenter",
  "build": {
    "frontendDist": "../../src/pc_agent/webui",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm --prefix .. run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omni-Assistant · Command Center",
        "url": "http://127.0.0.1:8765/",
        "width": 1560,
        "height": 980,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
